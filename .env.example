# Server-side YouTube Data API v3 key. Keep this out of the frontend bundle.
YOUTUBE_API_KEY=

# Firebase web config is client-side; restrict its browser API key appropriately.
# Flutterwave public key only; never expose the Flutterwave secret key in frontend code.
VITE_FLUTTERWAVE_PUBLIC_KEY=

# Kivora owner billing bypass is hard-coded in src/access.js and functions/access.js.
# Do not add the owner email as a client-supplied environment variable.
