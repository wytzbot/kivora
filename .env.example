# Server-side YouTube Data API v3 key. Keep this out of the frontend bundle.
YOUTUBE_API_KEY=

# Firebase web config is client-side; restrict its browser API key appropriately.
# Flutterwave public key only; never expose the Flutterwave secret key in frontend code.
VITE_FLUTTERWAVE_PUBLIC_KEY=

# Kivora owner billing bypass is hard-coded in src/access.js and functions/access.js.
# Do not add the owner email as a client-supplied environment variable.

# Server-only Firebase Admin credentials. JSON must be kept secret and never shipped to Vite.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=kivoraa

# Server-only Flutterwave v4 API credentials. Never expose these to the browser.
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
# Exact secret hash configured in Flutterwave Dashboard > Webhooks; server-side only.
FLW_WEBHOOK_SECRET_HASH=
KIVORA_PAYMENT_REDIRECT_URL=
KIVORA_USD_NGN_RATE=1300

# --- Android (Capacitor) build ---
# Deployed site URL. The APK only bundles static files, so it calls your Vercel /api routes here.
VITE_API_BASE_URL=https://kivora-ecru.vercel.app
# Public https URL used for share links (usually the same as VITE_API_BASE_URL).
VITE_PUBLIC_URL=https://kivora-ecru.vercel.app

# Shared secret for WyBuild's verified Flutterwave v4 webhook callback
WYBUILD_WEBHOOK_SHARED_SECRET=replace-with-the-same-long-random-secret-configured-in-WyBuild
